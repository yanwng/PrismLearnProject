<UserControl x:Class="PrismLearnProject.Views.Regions.RegionA"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PrismLearnProject.Views.Regions"
             mc:Ignorable="d" 
             xmlns:p="http://prismlibrary.com/"
             p:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock FontSize="50" Foreground="Orange" Text="我是区域A"/>
        <TextBlock FontSize="50" Foreground="Orange" Text="{Binding Count}"/>
        <Button Width="100" Height="50" IsEnabled="{Binding IsEnable}" Command="{Binding CountIncreate}">Count++</Button>

        <StackPanel Margin="10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Margin="10" Height="50" Width="120"   Command="{Binding GoBack}">上一个</Button>
            <Button Margin="10" Height="50" Width="120"   Command="{Binding GoForward}">下一个</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
